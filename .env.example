# Copy this file to .env (in the same folder as app.py you're running) and
# fill in your Postgres connection string — e.g. from Neon's dashboard.
# Prefer Neon's *pooled* connection string (host with "-pooler" in it) —
# it stacks with this app's own connection pooling for the best latency.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Required for the Owner portal login. There is no built-in default —
# pick a real password. Anyone who has this can manage the menu, see
# reports, and delete order history, so keep it out of version control.
OWNER_PASSWORD=

# Optional. Any long random string — used to sign owner login tokens.
# If left blank, a stable key is derived from OWNER_PASSWORD instead, so
# things still work, but a dedicated SECRET_KEY is better practice.
SECRET_KEY=
